{
  "name": "cloudwatch-apm-docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:integration": "jest --config jest.integration.config.js",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:links": "node scripts/validate-links.js",
    "validate:deployed-links": "node scripts/validate-deployed-links.js",
    "validate:markdown": "markdownlint content/**/*.md src/content/**/*.md",
    "validate:assets": "node scripts/validate-images.js",
    "validate:frontmatter": "node scripts/validate-frontmatter.js",
    "validate:code-examples": "node scripts/validate-code-examples.js",
    "validate:content-structure": "node scripts/validate-content-structure.js",
    "validate:accessibility": "node scripts/validate-accessibility.js",
    "generate:content-report": "node scripts/generate-content-report.js",
    "validate:all": "npm run validate:links && npm run validate:markdown && npm run validate:assets && npm run validate:frontmatter && npm run validate:code-examples && npm run validate:content-structure && npm run validate:accessibility",
    "deploy:staging": "npm run build && aws s3 sync .next s3://$STAGING_BUCKET --delete",
    "deploy:production": "npm run build && aws s3 sync .next s3://$PRODUCTION_BUCKET --delete",
    "rollback:staging": "node scripts/rollback.js staging",
    "rollback:production": "node scripts/rollback.js production"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "fuse.js": "^7.1.0",
    "gray-matter": "^4.0.3",
    "next": "^15.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "autoprefixer": "^10.4.20",
    "cspell": "^8.15.6",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.1",
    "fast-check": "^4.5.2",
    "glob": "^11.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "markdown-link-check": "^3.12.2",
    "markdownlint-cli": "^0.42.0",
    "postcss": "^8.5.4",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
